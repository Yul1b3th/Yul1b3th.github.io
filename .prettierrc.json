{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "semi": true,
  "experimentalTernaries": true,
  "jsxSingleQuote": true,
  "quoteProps": "preserve",
  "trailingComma": "es5",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "css",
  "proseWrap": "always",
  "requirePragma": false,
  "tabWidth": 2,
  "useTabs": false,
  "embeddedLanguageFormatting": "auto",
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "embeddedLanguageFormatting": "auto",
        "htmlWhitespaceSensitivity": "css",
        "printWidth": 200,
        "singleAttributePerLine": false
      }
    }
  ]
}
